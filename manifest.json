{
    "name": "Youtube No Distractions",
    "description": "Block Youtube's distractions",
    "version": "1.0",
    "manifest_version": 3,
    "action":
    {
        "default_popup": "index.html"
    },
    "content_scripts":[
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content-script.js"],
            "css": ["content-selector.css"]
        }
    ]
}